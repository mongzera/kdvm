
# ---------------------------------------------------------
# Subroutine: calculate_fact
# ---------------------------------------------------------
::calculate_fact
    PUSH 0
    LOAD
    PUSH 1
    CMPGT
    JZ 29
    PUSH 1
    PUSH 1
    LOAD
    PUSH 0
    LOAD
    MUL
    STORE
    PUSH 0
    PUSH 0
    LOAD
    PUSH 1
    SUB
    STORE
    JUMP 0
    RET

# =========================================================
# Global / Main entry point
# =========================================================
::_global
    PUSH 0
    IN 0
    STORE
    PUSH 1
    PUSH 1
    STORE
    PUSH 0
    LOAD
    PUSH 0
    CMPLT
    JZ 23
    CPUSH 'E'
    OUT
    JUMP 29
    CALL calculate_fact
    PUSH 1
    LOAD
    OUT
    HALT
