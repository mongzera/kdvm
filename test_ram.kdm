# Memory Check Entry Point
::_global
    # 1. Test STORE: Store 99 at RAM[5]
    PUSH 5          # Address
    PUSH 99         # Value
    STORE

    # 2. Test LOAD: Load from RAM[5]
    PUSH 5          # Address
    LOAD            # Should push 99 onto the stack

    # 3. Print the result
    OUT             # If this prints 99, your memory system works!
    HALT
